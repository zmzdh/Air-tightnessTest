<UserControl x:Class="LumbarMassageTest.Views.PrintTemplateControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" CornerRadius="5" Padding="15" Margin="0,0,10,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="打印模板" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="默认打印机" Margin="0,0,0,4"/>
                    <ComboBox Name="CmbPrinters" Height="30" Margin="0,0,0,8"/>
                    <Button Content="保存默认打印机" Height="32" Click="BtnSavePrinter_Click"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBox Name="TxtNewTemplateCode" Width="180" Height="28" Margin="0,0,8,0"/>
                    <Button Content="新建" Width="70" Click="BtnCreateTemplate_Click"/>
                    <Button Content="刷新" Width="70" Margin="8,0,0,0" Click="BtnRefresh_Click"/>
                </StackPanel>

                <ListBox Name="TemplateListBox" SelectionChanged="TemplateListBox_SelectionChanged"/>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Background="White" CornerRadius="5" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Name="TxtTemplateTitle" Text="请选择模板" FontSize="18" FontWeight="Bold" Margin="0,0,0,14"/>

                <WrapPanel Grid.Row="1" Margin="0,0,0,16">
                    <Button Content="编辑模板" Width="110" Height="34" Margin="0,0,10,0" Click="BtnEditTemplate_Click"/>
                    <Button Content="删除模板" Width="110" Height="34" Margin="0,0,10,0" Click="BtnDeleteTemplate_Click"/>
                    <Button Content="导入JSON" Width="110" Height="34" Margin="0,0,10,0" Click="BtnImportTemplate_Click"/>
                    <Button Content="导出JSON" Width="110" Height="34" Margin="0,0,10,0" Click="BtnExportTemplate_Click"/>
                    <Button Content="测试打印" Width="110" Height="34" Click="BtnTestPrint_Click"/>
                </WrapPanel>

                <ScrollViewer Grid.Row="2"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Background="#FFF3F4F6">
                    <Grid Margin="20">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Name="TxtPreviewSize" Margin="0,0,0,8" Foreground="#FF4B5563"/>
                            <Border Name="PreviewHost"
                                    Background="White"
                                    BorderBrush="#FF9CA3AF"
                                    BorderThickness="1"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top">
                                <Image Name="ImgTemplatePreview"
                                       Stretch="Fill"
                                       SnapsToDevicePixels="True"/>
                            </Border>
                            <TextBlock Name="TxtPreviewEmpty"
                                       Text="请选择模板"
                                       Margin="0,10,0,0"
                                       Foreground="#FF6B7280"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <TextBlock Grid.Row="3" Name="TxtStatus" Text="就绪" Margin="0,14,0,0" Foreground="#FF374151"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
