<Window x:Class="LabelTransPrint.LabelTemplateEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="打印模板编辑"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="250" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="520" MinWidth="400" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="3"
                Background="#FFF8FAFC"
                BorderBrush="#FFE2E8F0"
                BorderThickness="1"
                Padding="8"
                Margin="0,0,0,8">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center">
                    <Button Content="保存" Width="80" Height="30" Margin="0,0,8,0" Background="#FF16A34A" Style="{StaticResource ToolbarButtonStyle}" Click="SaveButton_Click" />
                    <Button Content="关闭" Width="80" Height="30" Background="#FF64748B" Style="{StaticResource ToolbarButtonStyle}" Click="CloseButton_Click" />
                </StackPanel>

                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="模板编码" VerticalAlignment="Center" Margin="0,0,6,6" />
                    <TextBox x:Name="TemplateCodeTextBox" Width="140" Height="28" Margin="0,0,12,6" VerticalContentAlignment="Center" />
                    <TextBlock Text="纸张(mm)" VerticalAlignment="Center" Margin="0,0,6,6" />
                    <TextBox x:Name="PaperWidthTextBox" Width="56" Height="28" Margin="0,0,4,6" VerticalContentAlignment="Center" />
                    <TextBlock Text="x" VerticalAlignment="Center" Margin="0,0,4,6" />
                    <TextBox x:Name="PaperHeightTextBox" Width="56" Height="28" Margin="0,0,16,6" VerticalContentAlignment="Center" />

                    <Button Content="文本" Width="58" Height="28" Margin="0,0,6,6" Background="#FF2563EB" Style="{StaticResource ToolbarButtonStyle}" Click="AddTextButton_Click" />
                    <Button Content="二维码" Width="68" Height="28" Margin="0,0,6,6" Background="#FF0F766E" Style="{StaticResource ToolbarButtonStyle}" Click="AddQrButton_Click" />
                    <Button Content="条形码" Width="68" Height="28" Margin="0,0,6,6" Background="#FF7C3AED" Style="{StaticResource ToolbarButtonStyle}" Click="AddBarcodeButton_Click" />
                    <Button Content="图片" Width="58" Height="28" Margin="0,0,6,6" Background="#FFCA8A04" Style="{StaticResource ToolbarButtonStyle}" Click="AddImageButton_Click" />
                    <Button Content="线条" Width="58" Height="28" Margin="0,0,6,6" Background="#FF475569" Style="{StaticResource ToolbarButtonStyle}" Click="AddLineButton_Click" />
                    <Button Content="表格" Width="58" Height="28" Margin="0,0,12,6" Background="#FF0891B2" Style="{StaticResource ToolbarButtonStyle}" Click="AddTableButton_Click" />

                    <Button Content="撤销" Width="58" Height="28" Margin="0,0,6,6" Background="#FF64748B" Style="{StaticResource ToolbarButtonStyle}" Click="UndoButton_Click" />
                    <Button Content="重做" Width="58" Height="28" Margin="0,0,12,6" Background="#FF64748B" Style="{StaticResource ToolbarButtonStyle}" Click="RedoButton_Click" />
                    <Button Content="剪切" Width="58" Height="28" Margin="0,0,6,6" Background="#FFEA580C" Style="{StaticResource ToolbarButtonStyle}" Click="CutButton_Click" />
                    <Button Content="复制" Width="58" Height="28" Margin="0,0,6,6" Background="#FF0F766E" Style="{StaticResource ToolbarButtonStyle}" Click="CopyButton_Click" />
                    <Button Content="粘贴" Width="58" Height="28" Margin="0,0,12,6" Background="#FF16A34A" Style="{StaticResource ToolbarButtonStyle}" Click="PasteButton_Click" />
                    <Button Content="删除选中" Width="86" Height="28" Margin="0,0,0,6" Background="#FFDC2626" Style="{StaticResource ToolbarButtonStyle}" Click="DeleteButton_Click" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="0"
                Background="#FFE7EBF0"
                BorderBrush="#FFCBD5E1"
                BorderThickness="1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          CanContentScroll="False">
                <Grid Margin="24">
                    <Canvas x:Name="DesignCanvas"
                            Background="White"
                            Focusable="True"
                            MouseLeftButtonDown="DesignCanvas_MouseLeftButtonDown" />
                </Grid>
            </ScrollViewer>
        </Border>

        <GridSplitter Grid.Row="1" Grid.Column="1"
                      Width="6"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Stretch"
                      Background="#FFE2E8F0"
                      ResizeDirection="Columns" />

        <Border Grid.Row="1" Grid.Column="2"
                Background="#FFF8FAFC"
                BorderBrush="#FFE2E8F0"
                BorderThickness="1"
                Padding="8"
                Margin="8,0,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" MinWidth="110" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" MinWidth="200" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="140" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <GroupBox Header="元素列表">
                    <ListBox x:Name="ItemsListBox"
                             DisplayMemberPath="Name"
                             SelectionChanged="ItemsListBox_SelectionChanged" />
                </GroupBox>

                <GridSplitter Grid.Column="1"
                              Width="8"
                              HorizontalAlignment="Stretch"
                              Background="Transparent"
                              ResizeDirection="Columns" />

                <GroupBox Grid.Column="2" Header="元素内容/字段">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <ComboBox x:Name="FieldComboBox"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Token"
                                  Margin="0,0,0,8">
                            <ComboBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       Foreground="#FF475569"
                                                       Margin="4,6,0,2" />
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ComboBox.GroupStyle>
                        </ComboBox>

                        <StackPanel Grid.Row="1"
                                    Orientation="Horizontal"
                                    Margin="0,0,0,8">
                            <Button x:Name="InsertFieldButton"
                                    Content="插入字段"
                                    Width="88"
                                    Height="28"
                                    Margin="0,0,8,0"
                                    Background="#FF2563EB"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Click="InsertFieldButton_Click" />
                            <Button x:Name="SelectImageButton"
                                    Content="选择图片文件"
                                    Width="110"
                                    Height="28"
                                    Background="#FFCA8A04"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Click="SelectImageButton_Click" />
                        </StackPanel>

                        <TextBox x:Name="ContentTextBox"
                                 Grid.Row="2"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 TextChanged="PropertyTextBox_TextChanged" />
                    </Grid>
                </GroupBox>

                <GridSplitter Grid.Row="1" Grid.ColumnSpan="3"
                              Height="8"
                              HorizontalAlignment="Stretch"
                              Background="Transparent"
                              ResizeDirection="Rows" />

                <GroupBox Grid.Row="2" Grid.ColumnSpan="3" Header="位置/尺寸/样式（方向键微调 0.1 mm）" MaxHeight="360">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="X" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,6" />
                            <TextBox x:Name="XTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,10,6" TextChanged="PropertyTextBox_TextChanged" />
                            <TextBlock Text="Y" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,6,6" />
                            <TextBox x:Name="YTextBox" Grid.Row="0" Grid.Column="3" Margin="0,0,0,6" TextChanged="PropertyTextBox_TextChanged" />

                            <TextBlock Text="宽" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,6" />
                            <TextBox x:Name="WidthTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,10,6" TextChanged="PropertyTextBox_TextChanged" />
                            <TextBlock Text="高" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,6,6" />
                            <TextBox x:Name="HeightTextBox" Grid.Row="1" Grid.Column="3" Margin="0,0,0,6" TextChanged="PropertyTextBox_TextChanged" />

                            <TextBlock Text="字号" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,6" />
                            <TextBox x:Name="FontSizeTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,10,6" TextChanged="PropertyTextBox_TextChanged" />
                            <CheckBox x:Name="BoldCheckBox"
                                      Grid.Row="2"
                                      Grid.Column="2"
                                      Grid.ColumnSpan="2"
                                      Content="加粗"
                                      Margin="0,0,0,8"
                                      Checked="BoldCheckBox_Changed"
                                      Unchecked="BoldCheckBox_Changed" />

                            <TextBlock Text="字体" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,6" />
                            <ComboBox x:Name="FontFamilyComboBox"
                                      Grid.Row="3"
                                      Grid.Column="1"
                                      Grid.ColumnSpan="3"
                                      Margin="0,0,0,6"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValuePath="SourceName"
                                      SelectionChanged="FontFamilyComboBox_SelectionChanged" />

                            <TextBlock Text="线宽" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,6" />
                            <TextBox x:Name="LineThicknessTextBox" Grid.Row="4" Grid.Column="1" Margin="0,0,10,6" TextChanged="PropertyTextBox_TextChanged" />
                            <TextBlock Text="线型" Grid.Row="4" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,6,6" />
                            <ComboBox x:Name="LineStyleComboBox" Grid.Row="4" Grid.Column="3" Margin="0,0,0,6" SelectionChanged="LineStyleComboBox_SelectionChanged">
                                <ComboBoxItem Content="Solid" />
                                <ComboBoxItem Content="Dash" />
                                <ComboBoxItem Content="Dot" />
                                <ComboBoxItem Content="DashDot" />
                            </ComboBox>

                            <TextBlock Text="行数" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,6" />
                            <TextBox x:Name="RowCountTextBox" Grid.Row="5" Grid.Column="1" Margin="0,0,10,6" TextChanged="TableShapeTextBox_TextChanged" />
                            <TextBlock Text="列数" Grid.Row="5" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,6,6" />
                            <TextBox x:Name="ColumnCountTextBox" Grid.Row="5" Grid.Column="3" Margin="0,0,0,6" TextChanged="TableShapeTextBox_TextChanged" />

                            <TextBlock Text="竖线X" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,6" />
                            <TextBox x:Name="TableColumnLineTextBox" Grid.Row="6" Grid.Column="1" Margin="0,0,10,6" />
                            <TextBlock Text="横线Y" Grid.Row="6" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,6,6" />
                            <TextBox x:Name="TableRowLineTextBox" Grid.Row="6" Grid.Column="3" Margin="0,0,0,6" />

                            <WrapPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,0,0,8">
                                <Button x:Name="InsertColumnLineButton" Content="插入竖线" Width="78" Height="28" Margin="0,0,6,0" Background="#FF0891B2" Style="{StaticResource ToolbarButtonStyle}" Click="InsertColumnLineButton_Click" />
                                <Button x:Name="InsertRowLineButton" Content="插入横线" Width="78" Height="28" Margin="0,0,6,0" Background="#FF0891B2" Style="{StaticResource ToolbarButtonStyle}" Click="InsertRowLineButton_Click" />
                                <Button x:Name="DeleteTableLineButton" Content="删除选中段" Width="94" Height="28" Margin="0,0,6,0" Background="#FFDC2626" Style="{StaticResource ToolbarButtonStyle}" Click="DeleteTableLineButton_Click" />
                                <Button x:Name="DeleteWholeTableLineButton" Content="删除整条线" Width="94" Height="28" Background="#FFB91C1C" Style="{StaticResource ToolbarButtonStyle}" Click="DeleteWholeTableLineButton_Click" />
                            </WrapPanel>

                            <TextBlock Grid.Row="8"
                                       Grid.Column="0"
                                       Grid.ColumnSpan="4"
                                       Text="表格内点击内部线段可选中，拖动可调整整条线位置；可删除选中段，也可删除该横线或竖线整条线。"
                                       Foreground="#FF64748B"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </ScrollViewer>
                </GroupBox>
            </Grid>
        </Border>
    </Grid>
</Window>
